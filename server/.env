# Copy this file to .env and fill in real values

PORT=4000

# PostgreSQL connection (use a free hosted Postgres like Neon, Supabase, or Render)
DATABASE_URL=postgresql://neondb_owner:npg_1FwWYMDozqT6@ep-long-scene-a54uads9-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
PGSSL=true

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS: comma separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Python interpreter available on the server (must be installed on the host)
PYTHON_BIN=python
